generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String   @db.VarChar(120)
  email          String   @unique @db.VarChar(254)
  passwordHash   String   @map("password_hash")
  isActive       Boolean  @default(true) @map("is_active")
  sessionVersion Int      @default(1) @map("session_version")
  version        Int      @default(1)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  events         Event[]

  @@map("users")
}

enum EventStatus {
  DRAFT
  PLANNED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum IncomeSourceKind {
  GENERAL
  CONTRIBUTION
}

model Event {
  id                String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerId           String                     @map("owner_id") @db.Uuid
  owner             User                       @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  name              String                     @db.VarChar(200)
  description       String?
  location          String?                    @db.VarChar(250)
  startDate         DateTime?                  @map("start_date") @db.Date
  endDate           DateTime?                  @map("end_date") @db.Date
  status            EventStatus                @default(DRAFT)
  currency          String                     @default("IDR") @db.Char(3)
  timezone          String                     @default("Asia/Jakarta") @db.VarChar(64)
  currentRevisionNo Int?                       @map("current_revision_no")
  budgetVersion     Int                        @default(1) @map("budget_version")
  version           Int                        @default(1)
  completedAt       DateTime?                  @map("completed_at") @db.Timestamptz(6)
  cancelledAt       DateTime?                  @map("cancelled_at") @db.Timestamptz(6)
  archivedAt        DateTime?                  @map("archived_at") @db.Timestamptz(6)
  createdAt         DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime                   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  settings          EventContributionSettings?
  sources           IncomeSource[]
  audits            AuditLog[]
  commands          IdempotencyRecord[]

  @@index([ownerId, archivedAt, status, createdAt, id])
  @@map("events")
}

model EventContributionSettings {
  eventId        String    @id @map("event_id") @db.Uuid
  event          Event     @relation(fields: [eventId], references: [id], onDelete: Restrict)
  defaultAmount  Decimal   @default(0) @map("default_amount") @db.Decimal(18, 2)
  defaultDueDate DateTime? @map("default_due_date") @db.Date
  updatedBy      String    @map("updated_by") @db.Uuid
  version        Int       @default(1)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("event_contribution_settings")
}

model IncomeSource {
  id         String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId    String           @map("event_id") @db.Uuid
  event      Event            @relation(fields: [eventId], references: [id], onDelete: Restrict)
  name       String           @db.VarChar(120)
  kind       IncomeSourceKind @default(GENERAL)
  archivedAt DateTime?        @map("archived_at") @db.Timestamptz(6)
  version    Int              @default(1)
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([eventId, id])
  @@map("income_sources")
}

model AuditLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId    String   @map("event_id") @db.Uuid
  event      Event    @relation(fields: [eventId], references: [id], onDelete: Restrict)
  actorId    String   @map("actor_id") @db.Uuid
  action     String   @db.VarChar(100)
  entityType String   @map("entity_type") @db.VarChar(80)
  entityId   String   @map("entity_id") @db.Uuid
  beforeJson Json?    @map("before_json")
  afterJson  Json?    @map("after_json")
  reason     String?
  requestId  String   @map("request_id") @db.VarChar(100)
  occurredAt DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([eventId, id])
  @@index([eventId, occurredAt, id])
  @@index([eventId, entityType, entityId, occurredAt])
  @@map("audit_logs")
}

model IdempotencyRecord {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId      String   @map("event_id") @db.Uuid
  event        Event    @relation(fields: [eventId], references: [id], onDelete: Restrict)
  actorId      String   @map("actor_id") @db.Uuid
  key          String   @db.VarChar(100)
  operation    String   @db.VarChar(100)
  requestHash  String   @map("request_hash") @db.Char(64)
  httpStatus   Int      @map("http_status") @db.SmallInt
  responseJson Json     @map("response_json")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([eventId, actorId, key])
  @@unique([eventId, id])
  @@map("idempotency_records")
}

model AuthRateLimit {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bucketKey       String   @map("bucket_key") @db.Char(64)
  windowStartedAt DateTime @map("window_started_at") @db.Timestamptz(6)
  windowSeconds   Int      @map("window_seconds")
  attemptCount    Int      @default(0) @map("attempt_count")
  expiresAt       DateTime @map("expires_at") @db.Timestamptz(6)
  updatedAt       DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@unique([bucketKey, windowStartedAt, windowSeconds])
  @@index([expiresAt])
  @@map("auth_rate_limits")
}
